<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="250"
        x:Class="WyreConnector.MainWindow"
        Title="Wyre Connector"
        Width="400" Height="250"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
    
    <Border Padding="24">
        <StackPanel Spacing="16" VerticalAlignment="Center">
            <TextBlock Text="Wyre Connector" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center"/>
            
            <TextBlock x:Name="NoRootModulesText"
                       Text="No root modules installed." 
                       HorizontalAlignment="Center"
                       Foreground="Gray"/>
            
            <TextBlock x:Name="InstallRootModuleText"
                       Text="Install a root module to get started:" 
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>
            
            <Button Content="wyre.zombidev.me/modules" 
                    HorizontalAlignment="Center"
                    Classes="link"
                    Click="OnLinkClick"/>
            
            <Button x:Name="ExitButton"
                    Content="Exit" 
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0"
                    Width="100"
                    Click="OnExitClick"/>
        </StackPanel>
    </Border>
</Window>
